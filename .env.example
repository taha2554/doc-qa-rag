# Everything is optional. With no API key the app runs in extractive mode
# (returns the most relevant passage instead of a generated answer).

# Set ONE of these to get generated answers with citations:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# DOCQA_LLM_PROVIDER=anthropic   # anthropic | openai | none (auto-detected from the keys above)
# DOCQA_LLM_MODEL=claude-haiku-5-5
# DOCQA_EMBEDDINGS=local         # local | openai
# DOCQA_INDEX_PATH=index/store.json
# DOCQA_CHUNK_SIZE=500
# DOCQA_CHUNK_OVERLAP=80
# DOCQA_TOP_K=4
